{"id":"t1328","taisho":"T1328","title":"佛說呪目經","translator":"東晉 曇無蘭譯","vol":"T21","juan":1,"chars":60,"content":[{"chapter":"卷001","text":"頺𭇅敷般𭇅敷　頞吒般𭇅敷　鳩離敷鳩離比敷　鳩羅鳩𧁢比敷　沙離莎𧁢波提敷　伊離敷　伊羅移敷　伊臘鼈敷\n若目痛，呪七過即愈。"}],"category":"密教部类","time_from":381,"translation_place":"興嚴寺","official_char_count":60,"actual_char_count":60,"juan_count":1}