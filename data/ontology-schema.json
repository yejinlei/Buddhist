{
  "meta": {
    "name": "佛学本体论",
    "version": "1.0.0",
    "description": "基于大正藏的完整佛学知识本体，覆盖义理、经典、宗派、人物、圣众、文化外延六大维度",
    "layers": [
      "L0_元模型层",
      "L1_教理本体层",
      "L2_义理范畴层",
      "L3_宗派体系层",
      "L4_文本载体层",
      "L5_人物传承层",
      "L6_信仰文化外延层"
    ]
  },
  "classes": {
    "L1_教理本体类": {
      "concept": {
        "label": "教理核心概念",
        "description": "佛学最顶层的形而上学核心概念",
        "properties": ["id", "name", "alias", "definition", "sutra_source", "sect_interpretation", "modern_interpretation"]
      }
    },
    "L2_义理范畴类": {
      "doctrine": {
        "label": "义理范畴",
        "description": "佛学核心修行与分析框架",
        "properties": ["id", "name", "alias", "structure", "definition", "sutra_source", "evolution", "sect_view"]
      }
    },
    "L3_宗派体系类": {
      "sect": {
        "label": "佛教宗派",
        "description": "汉传、藏传、南传各宗派",
        "properties": ["id", "name", "alias", "founder", "found_time", "found_place", "core_sutra", "core_doctrine", "panjiao_system", "inheritance"]
      },
      "panjiao": {
        "label": "判教体系",
        "description": "各宗派对佛陀教法的分类与判摄体系",
        "properties": ["id", "sect_id", "name", "levels", "content", "representative"]
      }
    },
    "L4_文本载体类": {
      "sutra": {
        "label": "佛经",
        "description": "经藏典籍",
        "properties": ["id", "taisho_id", "name", "alias", "category", "volume_count", "translator", "translate_time", "translate_place", "core_content", "core_concept", "keban_structure", "translations", "commentaries"]
      },
      "vinaya": {
        "label": "律典",
        "description": "律藏典籍",
        "properties": ["id", "taisho_id", "name", "alias", "category", "volume_count", "translator", "translate_time", "core_content"]
      },
      "sastra": {
        "label": "论典",
        "description": "论藏典籍",
        "properties": ["id", "taisho_id", "name", "alias", "category", "volume_count", "author", "write_time", "core_content", "core_concept"]
      },
      "commentary": {
        "label": "注疏",
        "description": "历代祖师对经论的注释",
        "properties": ["id", "name", "author", "write_time", "target_sutra", "core_content", "keban_structure"]
      },
      "translation": {
        "label": "译本",
        "description": "同一部经的不同译本",
        "properties": ["id", "sutra_id", "name", "translator", "translate_time", "translate_place", "volume_count", "text_length", "differences"]
      }
    },
    "L5_人物传承类": {
      "buddha": {
        "label": "佛陀",
        "description": "佛教中的佛陀",
        "properties": ["id", "name", "sanskrit_name", "alias", "era", "place", "core_teachings", "sutra_records", "symbol", "mantra"]
      },
      "bodhisattva": {
        "label": "菩萨",
        "description": "大乘佛教菩萨",
        "properties": ["id", "name", "sanskrit_name", "alias", "vow", "pure_land", "sutra_records", "symbol", "mantra", "representative_sutra"]
      },
      "arhat": {
        "label": "阿罗汉/尊者",
        "description": "声闻乘圣者",
        "properties": ["id", "name", "sanskrit_name", "alias", "achievements", "discipleship", "sutra_records", "symbol"]
      },
      "master": {
        "label": "历代祖师高僧",
        "description": "佛教史上的译经师、论师、宗派祖师",
        "properties": ["id", "name", "secular_name", "era", "birth_place", "sect", "achievements", "works", "inheritance", "stories"]
      },
      "modern_scholar": {
        "label": "现代佛教学者",
        "description": "近现代佛学研究学者",
        "properties": ["id", "name", "era", "research_field", "works", "core_view"]
      }
    },
    "L6_信仰文化外延类": {
      "deity": {
        "label": "护法/诸天",
        "description": "护法神、天龙八部、诸天",
