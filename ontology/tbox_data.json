aya", "Sastra", "Commentary", "Translation"], "axes": ["A2"], "layer": "L4"}, {"id": "Sutra", "label": "经", "parent": "Text", "desc": "经藏典籍，对应 SutraPitaka。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Vinaya", "label": "律", "parent": "Text", "desc": "律藏典籍，对应 VinayaPitaka。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Sastra", "label": "论", "parent": "Text", "desc": "论藏典籍，对应 AbhidharmaPitaka。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Commentary", "label": "注疏", "parent": "Text", "desc": "历代祖师对经论的注释。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Translation", "label": "译本", "parent": "Text", "desc": "同一部经的不同译本。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "CanonCategory", "label": "部类", "parent": null, "desc": "大正藏典籍的部类划分（阿含 / 般若 / 法华 / 华严 …）。", "subclasses": [], "axes": ["A1"], "layer": "L4"}, {"id": "Division", "label": "分部", "parent": null, "desc": "大正藏内部分部（如阿含部含长/中/杂/增一阿含），介于三藏与部类之间。", "subclasses": [], "axes": ["A1"], "layer": "L4"}, {"id": "Kepan", "label": "科判", "parent": null, "desc": "一部经的三分结构（序分 / 正宗分 / 流通分）。", "subclasses": ["IntroductoryPart", "EssentialPart", "CirculationPart"], "axes": ["A2"], "layer": "L4"}, {"id": "IntroductoryPart", "label": "序分", "parent": "Kepan", "desc": "证信序与发起序，明说法时处因缘。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "EssentialPart", "label": "正宗分", "parent": "Kepan", "desc": "一经正所诠之法门。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "CirculationPart", "label": "流通分", "parent": "Kepan", "desc": "付嘱流通，令法久住。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Chapter", "label": "品章", "parent": null, "desc": "经中的品或卷级单位。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Section", "label": "段落", "parent": null, "desc": "科判下的基本段落单位。", "subclasses": [], "axes": ["A2"], "layer": "L4"}, {"id": "Gatha", "label": "偈颂", "parent": null, "desc": "韵文体偈颂，一般紧随「而说偈言 / 说偈言 / 偈曰」等偈头之后。", "subclasses": [], "axes": ["A2"], "layer": "L4"},