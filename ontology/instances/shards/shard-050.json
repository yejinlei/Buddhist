],"mantras":[],"figures":[],"doctrines":[],"char_count":83},{"id":"c038","chapter_no":39,"chapter_title":"第三十九章 教诲无差","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00038"],"gathas":[],"mantras":[],"figures":[],"doctrines":[],"char_count":32},{"id":"c039","chapter_no":40,"chapter_title":"第四十章 行道在心","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00039"],"gathas":[],"mantras":[],"figures":[],"doctrines":[],"char_count":33},{"id":"c040","chapter_no":41,"chapter_title":"第四十一章 直心出欲","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00040"],"gathas":[],"mantras":[],"figures":[],"doctrines":[],"char_count":56},{"id":"c041","chapter_no":42,"chapter_title":"第四十二章 达世如幻","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00041"],"gathas":[],"mantras":[],"figures":[],"doctrines":["c008"],"char_count":118}],"paragraphs":[{"id":"p00000","chapter_id":"c000","para_no":1,"text_preview":"佛言：辞亲出家，识心达本，解无为法，名曰沙门。常行二百五十戒，进止清净，为四真道行，成阿罗汉。阿罗汉者，能飞行变化，旷劫寿命，住动天地。次为阿那含，阿那含者，寿","char_count":151,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00001","chapter_id":"c001","para_no":1,"text_preview":"佛言：出家沙门者，断欲去爱，识自心源，达佛深理，悟无为法。内无所得，外无所求，心不系道，亦不结业，无念无作，非修非证，不历诸位而自崇最，名之为道。","char_count":73,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00002","chapter_id":"c002","para_no":1,"text_preview":"佛言：剃除须发而为沙门，受道法者，去世资财，乞求取足，日中一食，树下一宿，慎勿再矣。使人愚蔽者，爱与欲也。","char_count":53,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00003","chapter_id":"c003","para_no":1,"text_preview":"佛言：众生以十事为善，亦以十事为恶。何等为十？身三、口四、意三。身三者：杀、盗、淫。口四者：两舌、恶口、妄言、绮语。意三者：嫉、恚、痴。如是十事，不顺圣道，名十","char_count":94,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00004","chapter_id":"c004","para_no":1,"text_preview":"佛言：人有众过而不自悔，顿息其心，罪来赴身，如水归海，渐成深广。若人有过，自解知非，改恶行善，罪自消灭，如病得汗，渐有痊损耳。","char_count":63,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00005","chapter_id":"c005","para_no":1,"text_preview":"佛言：恶人闻善，故来扰乱者，汝自禁息，当无瞋责，彼来恶者而自恶之。","char_count":33,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00006","chapter_id":"c006","para_no":1,"text_preview":"佛言：有人闻吾守道行大仁慈，故致骂佛。佛默不对，骂止，问曰：子以礼从人，其人不纳，礼归子乎？对曰：归矣。佛言：今子骂我，我今不纳，子自持祸归子身矣。犹响应声，影","char_count":94,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00007","chapter_id":"c007","para_no":1,"text_preview":"佛言：恶人害贤者，犹仰天而唾，唾不至天，还从己堕；逆风扬尘，尘不至彼，还坌己身。贤不可毁，祸必灭己。","char_count":50,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00008","chapter_id":"c008","para_no":1,"text_preview":"佛言：博闻爱道，道必难会；守志奉道，其道甚大。","char_count":23,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00009","chapter_id":"c009","para_no":1,"text_preview":"佛言：睹人施道，助之欢喜，得福甚大。沙门问曰：此福尽乎？佛言：譬如一炬之火，数百千人各以炬来分取，熟食除冥，此炬如故，福亦如之。","char_count":64,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00010","chapter_id":"c010","para_no":1,"text_preview":"佛言：饭恶人百，不如饭一善人；饭善人千，不如饭一持五戒者；饭持五戒者万，不如饭一须陀洹；饭百万须陀洹，不如饭一斯陀含；饭千万斯陀含，不如饭一阿那含；饭一亿阿那含","char_count":143,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00011","chapter_id":"c011","para_no":1,"text_preview":"佛言：人有二十难：贫穷布施难，豪贵学道难，弃命必死难，得睹佛经难，生值佛世难，忍色忍欲难，见好不求难，被辱不瞋难，有势不临难，触事无心难，广学博究难，除灭我慢难","char_count":129,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c048"]},{"id":"p00012","chapter_id":"c012","para_no":1,"text_preview":"沙门问佛：以何因缘，得知宿命，会其至道？佛言：净心守志，可会至道。譬如磨镜，垢去明存，断欲无求，当得宿命。","char_count":53,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00013","chapter_id":"c013","para_no":1,"text_preview":"沙门问佛：何者为善？何者最大？佛言：行道守真者善，志与道合者大。","char_count":32,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00014","chapter_id":"c014","para_no":1,"text_preview":"沙门问佛：何者多力？何者最明？佛言：忍辱多力，不怀恶故，兼加安健，忍者无恶，必为人尊。心垢灭尽，净无瑕秽，是为最明。未有天地逮于今日，十方所有，无有不见、无有不","char_count":92,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00015","chapter_id":"c015","para_no":1,"text_preview":"佛言：人怀爱欲不见道者，譬如澄水致手搅之，众人共临，无有睹其影者。人以爱欲交错，心中浊兴，故不见道。汝等沙门当舍爱欲，爱欲垢尽，道可见矣。","char_count":69,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00016","chapter_id":"c016","para_no":1,"text_preview":"佛言：夫见道者，譬如持炬入冥室中，其冥即灭，而明独存。学道见谛，无明即灭，而明常存矣。","char_count":43,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00017","chapter_id":"c017","para_no":1,"text_preview":"佛言：吾法念无念念，行无行行，言无言言，修无修修。会者近尔，迷者远乎。言语道断，非物所拘，差之毫厘，失之须臾。","char_count":55,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00018","chapter_id":"c018","para_no":1,"text_preview":"佛言：观天地念非常，观世界念非常，观灵觉即菩提。如是知识，得道疾矣。","char_count":34,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00019","chapter_id":"c019","para_no":1,"text_preview":"佛言：当念身中四大，各自有名，都无我者，我既都无，其如幻耳。","char_count":30,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c005"]},{"id":"p00020","chapter_id":"c020","para_no":1,"text_preview":"佛言：人随情欲求声名，声名显著，身已故矣。贪世常名而不学道，枉功劳形，譬如烧香，虽人闻香，香之烬矣，危身之火而在其后。","char_count":59,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00021","chapter_id":"c021","para_no":1,"text_preview":"佛言：财色于人，人之不舍，譬如刀刃有蜜，不足一餐之美，小儿舔之，则有割舌之患。","char_count":39,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00022","chapter_id":"c022","para_no":1,"text_preview":"佛言：人系于妻子舍宅，甚于牢狱。牢狱有散释之期，妻子无远离之念。情爱于色，岂惮驱驰，虽有虎口之患，心存甘伏，投泥自溺，故曰凡夫。透得此门，出尘罗汉。","char_count":74,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00023","chapter_id":"c023","para_no":1,"text_preview":"佛言：爱欲莫甚于色，色之为欲，其大无外，赖有一矣，若使二同，普天之人无能为道者矣。","char_count":41,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00024","chapter_id":"c024","para_no":1,"text_preview":"佛言：爱欲之人，犹如执炬逆风而行，必有烧手之患。","char_count":24,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00025","chapter_id":"c025","para_no":1,"text_preview":"天神献玉女于佛，欲坏佛意。佛言：革囊众秽，尔来何为？去，吾不用。天神愈敬，因问道意，佛为解说，即得须陀洹果。","char_count":54,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00026","chapter_id":"c026","para_no":1,"text_preview":"佛言：夫为道者，犹木在水，寻流而行，不左触岸，不右触岸，不为人取，不为鬼神所遮，不为洄流所住，亦不腐败，吾保此木决定入海。学道之人不为情欲所惑，不为众邪所娆，精","char_count":93,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00027","chapter_id":"c027","para_no":1,"text_preview":"佛言：慎勿信汝意，汝意不可信；慎勿与色会，色会即祸生。得阿罗汉已，乃可信汝意。","char_count":39,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00028","chapter_id":"c028","para_no":1,"text_preview":"佛言：慎勿视女色，亦莫共言语，若与语言，正心思念：我为沙门，处于浊世，当如莲华，不为泥污。想其老者如母，长者如姊，少者如妹，稚者如子，生度脱心，息灭恶念。","char_count":77,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00029","chapter_id":"c029","para_no":1,"text_preview":"佛言：夫为道者，如被干草，火来须避。道人见欲，必当远之。","char_count":28,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00030","chapter_id":"c030","para_no":1,"text_preview":"佛言：有人患淫不止，欲自断阴。佛谓之曰：若断其阴，不如断心。心如功曹，功曹若止，从者都息。邪心不止，断阴何益？佛为说偈：欲生于汝意，意以思想生，二心各寂静，非色","char_count":95,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00031","chapter_id":"c031","para_no":1,"text_preview":"佛言：人从爱欲生忧，从忧生怖，若离于爱，何忧何怖？","char_count":25,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00032","chapter_id":"c032","para_no":1,"text_preview":"佛言：夫为道者，譬如一人与万人战，挂铠出门，意或怯弱，或半路而退，或格斗而死，或得胜而还。沙门学道应当坚持其心，精进勇锐，不畏前境，破灭众魔而得道果。","char_count":75,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00033","chapter_id":"c033","para_no":1,"text_preview":"沙门夜诵迦叶佛遗教经，其声悲紧，思悔欲退。佛问之曰：汝昔在家曾为何业？对曰：爱弹琴。佛言：弦缓如何？对曰：不鸣矣。弦急如何？对曰：声绝矣。急缓得中如何？对曰：诸","char_count":155,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00034","chapter_id":"c034","para_no":1,"text_preview":"佛言：如人锻铁，去滓成器，器即精好。学道之人去心垢染，行即清净矣。","char_count":33,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00035","chapter_id":"c035","para_no":1,"text_preview":"佛言：人离恶道得为人难，既得为人，去女即男难；既得为男，六根完具难；六根既具，生中国难；既生中国，值佛世难；既值佛世，遇道者难；既得遇道，兴信心难；既兴信心，发","char_count":97,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00036","chapter_id":"c036","para_no":1,"text_preview":"佛言：佛子离吾数千里，忆念吾戒，必得道果；在吾左右，虽常见吾，不顺吾戒，终不得道。","char_count":41,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00037","chapter_id":"c037","para_no":1,"text_preview":"佛问沙门：人命在几间？对曰：数日间。佛言：子未知道。复问一沙门：人命在几间？对曰：饭食间。佛言：子未知道。复问一沙门：人命在几间？对曰：呼吸间。佛言：善哉，子知","char_count":83,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00038","chapter_id":"c038","para_no":1,"text_preview":"佛言：学佛道者，佛所言说皆应信顺，譬如食蜜，中边皆甜，吾经亦尔。","char_count":32,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00039","chapter_id":"c039","para_no":1,"text_preview":"佛言：沙门行道，无如磨牛，身虽行道，心道不行，心道若行，何用行道。","char_count":33,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00040","chapter_id":"c040","para_no":1,"text_preview":"佛言：夫为道者，如牛负重行深泥中，疲极不敢左右顾视，出离淤泥乃可苏息。沙门当观情欲甚于淤泥，直心念道，可免苦矣。","char_count":56,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00041","chapter_id":"c041","para_no":1,"text_preview":"佛言：吾视王侯之位如过隙尘，视金玉之宝如瓦砾，视纨素之服如敝帛，视大千世界如一诃子，视阿耨池水如涂足油，视方便门如化宝聚，视无上乘如梦金帛，视佛道如眼前华，视禅","char_count":118,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]}],"gathas":[],"mantras":[],"figure_mentions":[],"doctrine_mentions":[{"concept_id":"c008","name":"涅槃","chapters":["c000","c001","c026","c041"],"mention_count":4},{"concept_id":"c048","name":"明心见性","chapters":["c011"],"mention_count":1},{"concept_id":"c005","name":"空性","chapters":["c019"],"mention_count":1}]},"xinjing_fayue":{"id":"xinjing_fayue","type":"Text","title":"普遍智藏般若波罗蜜多心经","title_zh":"普遍智藏般若波罗蜜多心经","translator":"法月","category":"般若部类","volume":"","juan_count":1,"actual_char_count":387,"canon_ref":"T.252","taisho":"T0252","vehicle":"大乘","mode":"显教","translation_place":"西京","time_from":731,"belongs_to_school":["般若","中观宗","三论宗"],"parallel_translations":[],"kepan":{"序分":[],"正宗分":["c000"],"流通分":[]},"chapters":[{"id":"c000","chapter_no":1,"chapter_title":"正文","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00000","p00001","p00002","p00003","p00004","p00005"],"gathas":[],"mantras":[],"figures":["p001","p101","p103"],"doctrines":["c003","c008","c011"],"char_count":377}],"paragraphs":[{"id":"p00000","chapter_id":"c000","para_no":1,"text_preview":"如是我闻。一时，佛在王舍大城灵鹫山中，与大比丘众满百千人，菩萨摩诃萨七万七千人俱，其名曰观世音菩萨、文殊师利菩萨、弥勒菩萨等，以为上首，皆得三昧总持，住不思议解","char_count":82,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p101","p103"],"doctrines":["c008"]},{"id":"p00001","chapter_id":"c000","para_no":2,"text_preview":"尔时，观自在菩萨摩诃萨在彼敷坐，于其众中即从座起，诣世尊所，面向合掌曲躬恭敬，瞻仰尊颜而白佛言：\"世尊，我欲于此会中说诸菩萨普遍智藏般若波罗蜜多心，唯愿世尊听我","char_count":93,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p103"],"doctrines":[]},{"id":"p00002","chapter_id":"c000","para_no":3,"text_preview":"尔时，世尊以妙梵音告观自在菩萨摩诃萨言：\"善哉善哉，具大悲者，听汝所说，与诸众生作大光明。\"","char_count":46,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p103"],"doctrines":[]},{"id":"p00003","chapter_id":"c000","para_no":4,"text_preview":"于是观自在菩萨摩诃萨蒙佛听许，佛所护念，入于慧光三昧正受。入此定已，以三昧力行深般若波罗蜜多时，照见五蕴自性皆空。","char_count":57,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p103"],"doctrines":["c003","c011"]},{"id":"p00004","chapter_id":"c000","para_no":5,"text_preview":"……尔时，世尊从三昧起，以梵音声安慰彼观自在菩萨摩诃萨言：\"善哉善哉，善男子，汝所说者是大菩萨之母，十方诸佛同所随喜，我亦随喜。\"","char_count":65,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p103"],"doctrines":[]},{"id":"p00005","chapter_id":"c000","para_no":6,"text_preview":"尔时，世尊而说咒曰：\"揭谛揭谛，波罗揭谛，波罗僧揭谛，菩提萨婆诃。\"","char_count":34,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001"],"doctrines":[]}],"gathas":[],"mantras":[],"figure_mentions":[{"figure_id":"p101","name":"文殊菩萨","chapters":["c000"],"mention_count":1},{"figure_id":"p103","name":"观世音菩萨","chapters":["c000"],"mention_count":1},{"figure_id":"p001","name":"释迦牟尼佛","chapters":["c000"],"mention_count":1}],"doctrine_mentions":[{"concept_id":"c008","name":"涅槃","chapters":["c000"],"mention_count":1},{"concept_id":"c003","name":"佛性","chapters":["c000"],"mention_count":1},{"concept_id":"c011","name":"五蕴","chapters":["c000"],"mention_count":1}]},"xinjing_jiumo":{"id":"xinjing_jiumo","type":"Text","title":"摩诃般若波罗蜜大明咒经","title_zh":"摩诃般若波罗蜜大明咒经","translator":"鸠摩罗什","category":"般若部类","volume":"","juan_count":1,"actual_char_count":368,"canon_ref":"T.250","taisho":"T0250","vehicle":"大乘","mode":"显教","translation_place":"","time_from":402,"belongs_to_school":["般若","中观宗","三论宗"],"parallel_translations":[],"kepan":{"序分":[],"正宗分":["c000"],"流通分":[]},"chapters":[{"id":"c000","chapter_no":1,"chapter_title":"正文","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00000","p00001","p00002","p00003","p00004"],"gathas":[],"mantras":[],"figures":["p103","p203"],"doctrines":["c002","c005","c008","c011"],"char_count":360}],"paragraphs":[{"id":"p00000","chapter_id":"c000","para_no":1,"text_preview":"观世音菩萨，行深般若波罗蜜多时，照见五阴空，度一切苦厄。","char_count":28,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p103"],"doctrines":["c011"]},{"id":"p00001","chapter_id":"c000","para_no":2,"text_preview":"舍利弗，色空故，无恼坏相；受空故，无受相；想空故，无知相；行空故，无作相；识空故，无觉相。何以故？舍利弗，非色异空，非空异色，色即是空，空即是色，受想行识亦复如","char_count":82,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p203"],"doctrines":[]},{"id":"p00002","chapter_id":"c000","para_no":3,"text_preview":"舍利弗，是诸法空相，不生不灭，不垢不净，不增不减。是空法，非过去，非未来，非现在。是故空中无色，无受想行识，无眼耳鼻舌身意，无色声香味触法，无眼界乃至无意识界，","char_count":158,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p203"],"doctrines":["c005","c008"]},{"id":"p00003","chapter_id":"c000","para_no":4,"text_preview":"三世诸佛依般若波罗蜜故，得阿耨多罗三藐三菩提。故知般若波罗蜜，是大明咒，是无上明咒，是无等等明咒，能除一切苦，真实不虚。故说般若波罗蜜咒曰：","char_count":70,"section_type":"咒语引导","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c002"]},{"id":"p00004","chapter_id":"c000","para_no":5,"text_preview":"竭帝竭帝，波罗竭帝，波罗僧竭帝，菩提僧莎呵。","char_count":22,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]}],"gathas":[],"mantras":[],"figure_mentions":[{"figure_id":"p103","name":"观世音菩萨","chapters":["c000"],"mention_count":1},{"figure_id":"p203","name":"舍利弗","chapters":["c000"],"mention_count":1}],"doctrine_mentions":[{"concept_id":"c011","name":"五蕴","chapters":["c000"],"mention_count":1},{"concept_id":"c005","name":"空性","chapters":["c000"],"mention_count":1},{"concept_id":"c008","name":"涅槃","chapters":["c000"],"mention_count":1},{"concept_id":"c002","name":"真如","chapters":["c000"],"mention_count":1}]},"xinjing_xuanzang":{"id":"xinjing_xuanzang","type":"Text","title":"般若波罗蜜多心经","title_zh":"般若波罗蜜多心经","translator":"玄奘","category":"般若部类","volume":"","juan_count":1,"actual_char_count":337,"canon_ref":"T.251","taisho":"T0251","vehicle":"大乘","mode":"显教","translation_place":"翠微寺","time_from":648,"belongs_to_school":["般若","中观宗","三论宗"],"parallel_translations":[],"kepan":{"序分":[],"正宗分":["c000"],"流通分":[]},"chapters":[{"id":"c000","chapter_no":1,"chapter_title":"正文","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00000","p00001","p00002","p00003"],"gathas":[],"mantras":[],"figures":["p103","p203"],"doctrines