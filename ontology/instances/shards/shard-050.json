t_of_kepan":"正宗分","paragraphs":["p00000"],"gathas":[],"mantras":[],"figures":[],"doctrines":[],"char_count":87},{"id":"c001","chapter_no":2,"chapter_title":"十二大愿","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00001","p00002","p00003","p00004","p00005","p00006","p00007","p00008","p00009","p00010","p00011","p00012","p00013","p00014","p00015"],"gathas":[],"mantras":[],"figures":["p001","p003","p101"],"doctrines":["c008"],"char_count":1022},{"id":"c002","chapter_no":3,"chapter_title":"救病延寿","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00016","p00017"],"gathas":[],"mantras":[],"figures":["p001","p003","p101"],"doctrines":[],"char_count":216},{"id":"c003","chapter_no":4,"chapter_title":"流通分","section_type":"章节","part_of_kepan":"流通分","paragraphs":["p00018","p00019","p00020"],"gathas":[],"mantras":[],"figures":["p001","p003"],"doctrines":[],"char_count":172}],"paragraphs":[{"id":"p00000","chapter_id":"c000","para_no":1,"text_preview":"如是我闻。一时，薄伽梵游化诸国，至广严城，住乐音树下，与大苾刍众八千人俱，菩萨摩诃萨三万六千，及国王、大臣、婆罗门、居士、天、龙、药叉、人、非人等无量大众，恭敬","char_count":87,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00001","chapter_id":"c001","para_no":1,"text_preview":"尔时，曼殊室利法王子承佛威神，从座而起，偏袒一肩，右膝著地，向薄伽梵曲躬合掌，白言：\"世尊，唯愿演说如是相类诸佛名号及本昔大愿殊胜功德，令诸闻者业障消除，为欲利","char_count":91,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p101"],"doctrines":[]},{"id":"p00002","chapter_id":"c001","para_no":2,"text_preview":"佛告曼殊室利：\"东方去此过十殑伽沙等佛土，有世界名净琉璃，佛号药师琉璃光如来、应、正等觉、明行圆满、善逝、世间解、无上丈夫、调御士、天人师、佛、薄伽梵。","char_count":76,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p003","p101"],"doctrines":[]},{"id":"p00003","chapter_id":"c001","para_no":3,"text_preview":"曼殊室利，彼世尊药师琉璃光如来本行菩萨道时，发十二大愿，令诸有情所求皆得：","char_count":37,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p003","p101"],"doctrines":[]},{"id":"p00004","chapter_id":"c001","para_no":4,"text_preview":"第一大愿：愿我来世得阿耨多罗三藐三菩提时，自身光明炽然照曜无量无数无边世界，以三十二大丈夫相、八十随好庄严其身，令一切有情如我无异。","char_count":66,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00005","chapter_id":"c001","para_no":5,"text_preview":"第二大愿：愿我来世得菩提时，身如琉璃，内外明彻净无瑕秽，光明广大功德巍巍，身善安住焰网庄严过于日月，幽冥众生悉蒙开晓，随意所趣作诸事业。","char_count":68,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00006","chapter_id":"c001","para_no":6,"text_preview":"第三大愿：愿我来世得菩提时，以无量无边智慧方便，令诸有情皆得无尽所受用物，莫令众生有所乏少。","char_count":46,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00007","chapter_id":"c001","para_no":7,"text_preview":"第四大愿：愿我来世得菩提时，若诸有情行邪道者，悉令安住菩提道中；若行声闻独觉乘者，皆以大乘而安立之。","char_count":50,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00008","chapter_id":"c001","para_no":8,"text_preview":"第五大愿：愿我来世得菩提时，若有无量无边有情于我法中修行梵行，一切皆令得不缺戒，具三聚戒；设有毁犯，闻我名已，还得清净，不堕恶趣。","char_count":65,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00009","chapter_id":"c001","para_no":9,"text_preview":"第六大愿：愿我来世得菩提时，若诸有情其身下劣、诸根不具、丑陋顽愚、盲聋喑哑、挛躄背偻、白癞癫狂、种种病苦，闻我名已，一切皆得端正黠慧，诸根完具，无诸疾苦。","char_count":77,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00010","chapter_id":"c001","para_no":10,"text_preview":"第七大愿：愿我来世得菩提时，若诸有情众病逼切、无救无归、无医无药、无亲无家、贫穷多苦，我之名号一经其耳，众病悉除，身心安乐，家属资具悉皆丰足，乃至证得无上菩提。","char_count":80,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00011","chapter_id":"c001","para_no":11,"text_preview":"第八大愿：愿我来世得菩提时，若有女人为女百恶之所逼恼，极生厌离，愿舍女身，闻我名已，一切皆得转女成男具丈夫相，乃至证得无上菩提。","char_count":64,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00012","chapter_id":"c001","para_no":12,"text_preview":"第九大愿：愿我来世得菩提时，令诸有情出魔羂网，解脱一切外道缠缚；若堕种种恶见稠林，皆当引摄置于正见，渐令修习诸菩萨行，速证无上正等菩提。","char_count":68,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00013","chapter_id":"c001","para_no":13,"text_preview":"第十大愿：愿我来世得菩提时，若诸有情王法所录、绳缚鞭挞、系闭牢狱、或当刑戮，及余无量灾难凌辱、悲愁煎逼、身心受苦，若闻我名，以我福德威神力故，皆得解脱一切忧苦。","char_count":80,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00014","chapter_id":"c001","para_no":14,"text_preview":"第十一大愿：愿我来世得菩提时，若诸有情饥渴所恼，为求食故造诸恶业，若闻我名、专念受持，我当先以上妙饮食饱足其身，后以法味毕竟安乐而建立之。","char_count":69,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00015","chapter_id":"c001","para_no":15,"text_preview":"第十二大愿：愿我来世得菩提时，若诸有情贫无衣服、蚊虻寒热昼夜逼恼，若闻我名、专念受持，如其所好即得种种上妙衣服，亦得一切宝庄严具、华鬘涂香、鼓乐众妓，随心所玩皆","char_count":85,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00016","chapter_id":"c002","para_no":1,"text_preview":"\"复次，曼殊室利，彼药师琉璃光如来得菩提时，由本愿力观诸有情，遇众病苦——瘦挛干消、黄热等病，或被魇魅蛊道所中、或复短命、或时横死——欲令是等病苦消除、所求愿满","char_count":81,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p003","p101"],"doctrines":[]},{"id":"p00017","chapter_id":"c002","para_no":2,"text_preview":"若见男子女人有病苦者，应当一心为彼病人常清净澡漱，或食或药、或无虫水，咒一百八遍与彼服食，所有病苦悉皆消灭。若有所求，至心念诵，皆得如是无病延年，命终之后生彼世","char_count":135,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p003","p101"],"doctrines":[]},{"id":"p00018","chapter_id":"c003","para_no":1,"text_preview":"尔时，阿难白佛言：\"世尊，当何名此法门？我等云何奉持？\"","char_count":28,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001"],"doctrines":[]},{"id":"p00019","chapter_id":"c003","para_no":2,"text_preview":"佛告阿难：\"此法门名《药师琉璃光如来本愿功德》，亦名《说十二神将饶益有情结愿神咒》，亦名《拔除一切业障》，应当持。\"","char_count":58,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p001","p003"],"doctrines":[]},{"id":"p00020","chapter_id":"c003","para_no":3,"text_preview":"时薄伽梵说是语已，诸菩萨摩诃萨及大声闻、国王、大臣、婆罗门、居士、天、龙、药叉、健达缚、阿素洛、揭路荼、紧捺洛、莫呼洛伽、人、非人等一切大众，闻佛所说，皆大欢喜","char_count":86,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]}],"gathas":[],"mantras":[],"figure_mentions":[{"figure_id":"p001","name":"释迦牟尼佛","chapters":["c001","c002","c003"],"mention_count":3},{"figure_id":"p003","name":"药师佛","chapters":["c001","c002","c003"],"mention_count":3},{"figure_id":"p101","name":"文殊菩萨","chapters":["c001","c002"],"mention_count":2}],"doctrine_mentions":[{"concept_id":"c008","name":"涅槃","chapters":["c001"],"mention_count":1}]},"yulan_pen":{"id":"yulan_pen","type":"Text","title":"佛说盂兰盆经","title_zh":"佛说盂兰盆经","translator":"竺法护","category":"經集部类","volume":"","juan_count":1,"actual_char_count":886,"canon_ref":"T.685","taisho":"T0685","vehicle":"大乘","mode":"显教","translation_place":"","time_from":266,"belongs_to_school":["经集部","诸经杂集"],"parallel_translations":[],"kepan":{"序分":[],"正宗分":["c000"],"流通分":[]},"chapters":[{"id":"c000","chapter_no":1,"chapter_title":"正文","section_type":"章节","part_of_kepan":"正宗分","paragraphs":["p00000","p00001","p00002","p00003","p00004","p00005","p00006","p00007","p00008","p00009"],"gathas":[],"mantras":[],"figures":["p204"],"doctrines":["c008"],"char_count":868}],"paragraphs":[{"id":"p00000","chapter_id":"c000","para_no":1,"text_preview":"闻如是。一时佛在舍卫国祇树给孤独园。","char_count":18,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00001","chapter_id":"c000","para_no":2,"text_preview":"大目犍连始得六通，欲度父母报乳哺之恩，即以道眼观视世间，见其亡母生饿鬼中，不见饮食，皮骨连立。目连悲哀，即以钵盛饭往饷其母。母得钵饭，便以左手障钵，右手搏食，食","char_count":113,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p204"],"doctrines":[]},{"id":"p00002","chapter_id":"c000","para_no":3,"text_preview":"佛言：\"汝母罪根深结，非汝一人力所奈何。汝虽孝顺声动天地，天神地祇、邪魔外道、道士四天王神亦不能奈何。当须十方众僧威神之力，乃得解脱。吾今当说救济之法，令一切难","char_count":86,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":["c008"]},{"id":"p00003","chapter_id":"c000","para_no":4,"text_preview":"佛告目连：\"十方众僧于七月十五日僧自恣时，当为七世父母及现在父母厄难中者，具饭、百味五果、汲灌盆器、香油锭烛、床敷卧具，尽世甘美以著盆中，供养十方大德众僧。当此","char_count":231,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p204"],"doctrines":["c008"]},{"id":"p00004","chapter_id":"c000","para_no":5,"text_preview":"时佛敕十方众僧，皆先为施主家咒愿，愿七世父母行禅定意，然后受食。初受食时，先安在佛前，塔寺中佛前，众僧咒愿竟，便自受食。","char_count":60,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00005","chapter_id":"c000","para_no":6,"text_preview":"时目连比丘及大菩萨众皆大欢喜。目连悲啼泣声释然除灭，是时目连母即于是日得脱一劫饿鬼之苦。","char_count":44,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p204"],"doctrines":[]},{"id":"p00006","chapter_id":"c000","para_no":7,"text_preview":"目连复白佛言：\"弟子所生母，得蒙三宝功德之力、众僧威神之力故；若未来世一切佛弟子，亦应奉盂兰盆救度现在父母乃至七世父母，可为尔不？\"","char_count":66,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p204"],"doctrines":[]},{"id":"p00007","chapter_id":"c000","para_no":8,"text_preview":"佛言：\"大善快问！我正欲说，汝今复问。善男子，若有比丘、比丘尼、国王、太子、大臣、宰相、三公、百官、万民庶人，行慈孝者，皆应先为所生现在父母、过去七世父母，于七","char_count":156,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00008","chapter_id":"c000","para_no":9,"text_preview":"是佛弟子修孝顺者，应念念中常忆父母乃至七世父母，年年七月十五日常以孝慈忆所生父母，为作盂兰盆，施佛及僧，以报父母长养慈爱之恩。若一切佛弟子，应当奉持是法。\"","char_count":78,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":[],"doctrines":[]},{"id":"p00009","chapter_id":"c000","para_no":10,"text_preview":"时目连比丘、四辈弟子，欢喜奉行。","char_count":16,"section_type":"长行","gatha_id":null,"mantra_id":null,"figures":["p204"],"doctrines":[]}],"gathas":[],"mantras":[],"figure_mentions":[{"figure_id":"p204","name":"目犍连","chapters":["c000"],"mention_count":1}],"doctrine_mentions":[{"concept_id":"c008","name":"涅槃","chapters":["c000"],"mention_count":1}]}}