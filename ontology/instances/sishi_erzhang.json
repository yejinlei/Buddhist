{"id": "sishi_erzhang", "type": "Text", "title": "佛说四十二章经", "title_zh": "佛说四十二章经", "translator": "迦叶摩腾、竺法兰", "category": "經集部类", "volume": "", "juan_count": 1, "actual_char_count": 2749, "canon_ref": "T.784", "taisho": "T0784", "vehicle": "大乘", "mode": "显教", "translation_place": "白馬寺", "time_from": 67, "belongs_to_school": ["经集部", "诸经杂集"], "parallel_translations": [], "kepan": {"序分": [], "正宗分": ["c000", "c001", "c002", "c003", "c004", "c005", "c006", "c007", "c008", "c009", "c010", "c011", "c012", "c013", "c014", "c015", "c016", "c017", "c018", "c019", "c020", "c021", "c022", "c023", "c024", "c025", "c026", "c027", "c028", "c029", "c030", "c031", "c032", "c033", "c034", "c035", "c036", "c037", "c038", "c039", "c040", "c041"], "流通分": []}, "chapters": [{"id": "c000", "chapter_no": 1, "chapter_title": "第一章 出家证果", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00000"], "gathas": [], "mantras": [], "figures": [], "doctrines": ["c008"], "char_count": 151}, {"id": "c001", "chapter_no": 2, "chapter_title": "第二章 断欲绝求", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00001"], "gathas": [], "mantras": [], "figures": [], "doctrines": ["c008"], "char_count": 73}, {"id": "c002", "chapter_no": 3, "chapter_title": "第三章 割爱去贪", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00002"], "gathas": [], "mantras": [], "figures": [], "doctrines": [], "char_count": 53}, {"id": "c003", "chapter_no": 4, "chapter_title": "第四章 善恶并明", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00003"], "gathas": [], "mantras": [], "figures": [], "doctrines": [], "char_count": 94}, {"id": "c004", "chapter_no": 5, "chapter_title": "第五章 转重令轻", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00004"], "gathas": [], "mantras": [], "figures": [], "doctrines": [], "char_count": 63}, {"id": "c005", "chapter_no": 6, "chapter_title": "第六章 忍恶无瞋", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00005"], "gathas": [], "mantras": [],