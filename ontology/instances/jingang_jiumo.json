      "doctrines": []
    },
    {
      "id": "p00081",
      "chapter_id": "c000",
      "para_no": 82,
      "text_preview": "「如是，世尊！如來有慧眼。」",
      "char_count": 14,
      "section_type": "长行",
      "gatha_id": null,
      "mantra_id": null,
      "figures": [
        "p001"
      ],
      "doctrines": []
    },
    {
      "id": "p00082",
      "chapter_id": "c000",
      "para_no": 83,
      "text_preview": "「須菩提！於意云何？如來有法眼不？」",
      "char_count": 18,
      "section_type": "长行",
      "gatha_id": null,
      "mantra_id": null,
      "figures": [],
      "doctrines": []
    },
    {
      "id": "p00083",
      "chapter_id": "c000",
      "para_no": 84,
      "text_preview": "「如是，世尊！如來有法眼。」",
      "char_count": 14,
