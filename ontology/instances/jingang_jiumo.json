, "figures": ["p001", "p205"], "doctrines": [], "char_count": 131}, {"id": "c020", "chapter_no": 21, "chapter_title": "非说所说分第二十一", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00101", "p00102", "p00103"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 153}, {"id": "c021", "chapter_no": 22, "chapter_title": "无法可得分第二十二", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00104", "p00105"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 78}, {"id": "c022", "chapter_no": 23, "chapter_title": "净心行善分第二十三", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00106"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": ["c005"], "char_count": 85}, {"id": "c023", "chapter_no": 24, "chapter_title": "福智无比分第二十四", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00107"], "gathas": [], "mantras": [], "figures": ["p205"], "doctrines": [], "char_count": 89}, {"id": "c024", "chapter_no": 25, "chapter_title": "化无所化分第二十五", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00108", "p00109"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 121}, {"id": "c025", "chapter_no": 26, "chapter_title": "法身非相分第二十六", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00110", "p00111", "p00112", "p00113", "p00114", "p00115", "p00116"], "gathas": ["g000"], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 138}, {"id": "c026", "chapter_no": 27, "chapter_title": "无断无灭分第二十七", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00117", "p00118"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 121}, {"id": "c027", "chapter_no": 28, "chapter_title": "不受不贪分第二十八", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00119", "p00120", "p00121"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": ["c005"], "char_count": 117}, {"id": "c028", "chapter_no": 29, "chapter_title": "威仪寂净分第二十九", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00122"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 56}, {"id": "c029", "chapter_no": 30, "chapter_title": "一合理相分第三十", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00123", "p00124", "p00125", "p00126"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 186}, {"id": "c030", "chapter_no": 31, "chapter_title": "知见不生分第三十一", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00127", "p00128", "p00129"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 181}, {"id": "c031", "chapter_no": 32, "chapter_title": "应化非真分第三十二", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00130", "p00131", "p00132", "p00133"], "gathas": [], "mantras": [], "figures": ["p205"], "doctrines": ["c002"], "char_count": 166}], "paragraphs": [{"id": "p00000", "chapter_id": "c000", "para_no": 1, "text_preview": "如是我闻。一时，佛在舍卫国祇树给孤独园，与大比丘众千二百五十人俱。尔时，世尊食时，著衣持钵，入舍卫大城乞食。于其城中次第乞已，还至本处。饭食讫，收衣钵，洗足已，", "char_count": 85, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00001", "chapter_id": "c001", "para_no": 1, "text_preview": "时，长老须菩提在大众中，即从座起，偏袒右肩，右膝著地，合掌恭敬而白佛言：\"希有，世尊！如来善护念诸菩萨，善付嘱诸菩萨。世尊，善男子、善女人发阿耨多罗三藐三菩提心", "char_count": 94, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00002", "chapter_id": "c001", "para_no": 2, "text_preview": "佛言：\"善哉！善哉！须菩提，如汝所说，如来善护念诸菩萨，善付嘱诸菩萨。汝今谛听，当为汝说。善男子、善女人发阿耨多罗三藐三菩提心，应如是住，如是降伏其心。\"", "char_count": 77, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00003", "chapter_id": "c001", "para_no": 3, "text_preview": "\"唯然，世尊，愿乐欲闻。\"", "char_count": 13, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00004", "chapter_id": "c002", "para_no": 1, "text_preview": "佛告须菩提：\"诸菩萨摩诃萨应如是降伏其心：所有一切众生之类，若卵生、若胎生、若湿生、若化生，若有色、若无色，若有想、若无想、若非有想非无想，我皆令入无余涅槃而灭", "char_count": 137, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": ["c008"]}, {"id": "p00005", "chapter_id": "c003", "para_no": 1, "text_preview": "\"复次，须菩提，菩萨于法应无所住，行于布施。所谓不住色布施，不住声、香、味、触、法布施。须菩提，菩萨应如是布施，不住于相。何以故？若菩萨不住相布施，其福德不可思", "char_count": 82, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00006", "chapter_id": "c003", "para_no": 2, "text_preview": "须菩提，于意云何？东方虚空可思量不？\"", "char_count": 19, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00007", "chapter_id": "c003", "para_no": 3, "text_preview": "\"不也，世尊。\"", "char_count": 8, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00008", "chapter_id": "c003", "para_no": 4, "text_preview": "\"须菩提，南、西、北方、四维、上下虚空可思量不？\"", "char_count": 25, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00009", "chapter_id": "c003", "para_no": 5, "text_preview": "\"不也，世尊。\"", "char_count": 8, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00010", "chapter_id": "c003", "para_no": 6, "text_preview": "\"须菩提，菩萨无住相布施，福德亦复如是不可思量。须菩提，菩萨但应如所教住。\"", "char_count": 38, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00011", "chapter_id": "c004", "para_no": 1, "text_preview": "\"须菩提，于意云何？可以身相见如来不？\"", "char_count": 20, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00012", "chapter_id": "c004", "para_no": 2, "text_preview": "\"不也，世尊。不可以身相得见如来。何以故？如来所说身相，即非身相。\"", "char_count": 34, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00013", "chapter_id": "c004", "para_no": 3, "text_preview": "佛告须菩提：\"凡所有相，皆是虚妄。若见诸相非相，即见如来。\"", "char_count": 30, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00014", "chapter_id": "c005", "para_no": 1, "text_preview": "须菩提白佛言：\"世尊，颇有众生得闻如是言说章句，生实信不？\"", "char_count": 30, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00015", "chapter_id": "c005", "para_no": 2, "text_preview": "佛告须菩提：\"莫作是说。如来灭后，后五百岁，有持戒修福者，于此章句能生信心，以此为实。当知是人，不于一佛二佛三四五佛而种善根，已于无量千万佛所种诸善根。闻是章句", "char_count": 113, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00016", "chapter_id": "c005", "para_no": 3, "text_preview": "何以故？是诸众生无复我相、人相、众生相、寿者相，无法相，亦无非法相。何以故？是诸众生，若心取相，则为著我、人、众生、寿者；若取法相，即著我、人、众生、寿者。何以", "char_count": 148, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00017", "chapter_id": "c006", "para_no": 1, "text_preview": "\"须菩提，于意云何？如来得阿耨多罗三藐三菩提耶？如来有所说法耶？\"", "char_count": 33, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00018", "chapter_id": "c006", "para_no": 2, "text_preview": "须菩提言：\"如我解佛所说义，无有定法名阿耨多罗三藐三菩提，亦无有定法如来可说。何以故？如来所说法，皆不可取、不可说，非法、非非法。所以者何？一切贤圣皆以无为法而", "char_count": 85, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": ["c008"]}, {"id": "p00019", "chapter_id": "c007", "para_no": 1, "text_preview": "\"须菩提，于意云何？若人满三千大千世界七宝以用布施，是人所得福德宁为多不？\"", "char_count": 38, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00020", "chapter_id": "c007", "para_no": 2, "text_preview": "须菩提言：\"甚多，世尊。何以故？是福德即非福德性，是故如来说福德多。\"", "char_count": 35, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00021", "chapter_id": "c007", "para_no": 3, "text_preview": "\"若复有人，于此经中乃至受持四句偈等，为他人说，其福胜彼。何以故？须菩提，一切诸佛及诸佛阿耨多罗三藐三菩提法，皆从此经出。须菩提，所谓佛法者，即非佛法。\"", "char_count": 77, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00022", "chapter_id": "c008", "para_no": 1, "text_preview": "\"须菩提，于意云何？须陀洹能作是念'我得须陀洹果'不？\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00023", "chapter_id": "c008", "para_no": 2, "text_preview": "须菩提言：\"不也，世尊。何以故？须陀洹名为入流，而无所入，不入色、声、香、味、触、法，是名须陀洹。\"", "char_count": 50, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00024", "chapter_id": "c008", "para_no": 3, "text_preview": "\"须菩提，于意云何？斯陀含能作是念'我得斯陀含果'不？\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00025", "chapter_id": "c008", "para_no": 4, "text_preview": "须菩提言：\"不也，世尊。何以故？斯陀含名一往来，而实无往来，是名斯陀含。\"", "char_count": 37, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00026", "chapter_id": "c008", "para_no": 5, "text_preview": "\"须菩提，于意云何？阿那含能作是念'我得阿那含果'不？\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00027", "chapter_id": "c008", "para_no": 6, "text_preview": "须菩提言：\"不也，世尊。何以故？阿那含名为不来，而实无不来，是故名阿那含。\"", "char_count": 38, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00028", "chapter_id": "c008", "para_no": 7, "text_preview": "\"须菩提，于意云何？阿罗汉能作是念'我得阿罗汉道'不？\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00029", "chapter_id": "c008", "para_no": 8, "text_preview": "须菩提言：\"不也，世尊。何以故？实无有法名阿罗汉。世尊，若阿罗汉作是念'我得阿罗汉道'，即为著我、人、众生、寿者。世尊，佛说我得无诤三昧，人中最为第一，是第一离", "char_count": 158, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00030", "chapter_id": "c009", "para_no": 1, "text_preview": "佛告须菩提：\"于意云何？如来昔在然灯佛所，于法有所得不？\"", "char_count": 29, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00031", "chapter_id": "c009", "para_no": 2, "text_preview": "\"不也，世尊。如来在然灯佛所，于法实无所得。\"", "char_count": 23, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00032", "chapter_id": "c009", "para_no": 3, "text_preview": "\"须菩提，于意云何？菩萨庄严佛土不？\"", "char_count": 19, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00033", "chapter_id": "c009", "para_no": 4, "text_preview": "\"不也，世尊。何以故？庄严佛土者，即非庄严，是名庄严。\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00034", "chapter_id": "c009", "para_no": 5, "text_preview": "\"是故，须菩提，诸菩萨摩诃萨应如是生清净心，不应住色生心，不应住声、香、味、触、法生心，应无所住而生其心。", "char_count": 53, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00035", "chapter_id": "c009", "para_no": 6, "text_preview": "须菩提，譬如有人身如须弥山王，于意云何？是身为大不？\"", "char_count": 27, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00036", "chapter_id": "c009", "para_no": 7, "text_preview": "须菩提言：\"甚大，世尊。何以故？佛说非身，是名大身。\"", "char_count": 27, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00037", "chapter_id": "c010", "para_no": 1, "text_preview": "\"须菩提，如恒河中所有沙数，如是沙等恒河，于意云何？是诸恒河沙宁为多不？\"", "char_count": 37, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00038", "chapter_id": "c010", "para_no": 2, "text_preview": "须菩提言：\"甚多，世尊。但诸恒河尚多无数，何况其沙。\"", "char_count": 27, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00039", "chapter_id": "c010", "para_no": 3, "text_preview": "\"须菩提，我今实言告汝：若有善男子、善女人，以七宝满尔所恒河沙数三千大千世界以用布施，得福多不？\"", "char_count": 49, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00040", "chapter_id": "c010", "para_no": 4, "text_preview": "须菩提言：\"甚多，世尊。\"", "char_count": 13, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00041", "chapter_id": "c010", "para_no": 5, "text_preview": "佛告须菩提：\"若善男子、善女人，于此经中乃至受持四句偈等，为他人说，而此福德胜前福德。\"", "char_count": 44, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00042", "chapter_id": "c011", "para_no": 1, "text_preview": "\"复次，须菩提，随说是经乃至四句偈等，当知此处，一切世间天、人、阿修罗皆应供养，如佛塔庙。何况有人尽能受持读诵！须菩提，当知是人成就最上第一希有之法。若是经典所", "char_count": 96, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00043", "chapter_id": "c012", "para_no": 1, "text_preview": "尔时，须菩提白佛言：\"世尊，当何名此经？我等云何奉持？\"", "char_count": 28, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00044", "chapter_id": "c012", "para_no": 2, "text_preview": "佛告须菩提：\"是经名为《金刚般若波罗蜜》，以是名字，汝当奉持。所以者何？须菩提，佛说般若波罗蜜，即非般若波罗蜜，是名般若波罗蜜。", "char_count": 64, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00045", "chapter_id": "c012", "para_no": 3, "text_preview": "须菩提，于意云何？如来有所说法不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00046", "chapter_id": "c012", "para_no": 4, "text_preview": "须菩提白佛言：\"世尊，如来无所说。\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00047", "chapter_id": "c012", "para_no": 5, "text_preview": "\"须菩提，于意云何？三千大千世界所有微尘是为多不？\"", "char_count": 26, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00048", "chapter_id": "c012", "para_no": 6, "text_preview": "须菩提言：\"甚多，世尊。\"", "char_count": 13, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00049", "chapter_id": "c012", "para_no": 7, "text_preview": "\"须菩提，诸微尘，如来说非微尘，是名微尘。如来说世界，非世界，是名世界。", "char_count": 36, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00050", "chapter_id": "c012", "para_no": 8, "text_preview": "须菩提，于意云何？可以三十二相见如来不？\"", "char_count": 21, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00051", "chapter_id": "c012", "para_no": 9, "text_preview": "\"不也，世尊。不可以三十二相得见如来。何以故？如来说三十二相，即是非相，是名三十二相。\"", "char_count": 44, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00052", "chapter_id": "c012", "para_no": 10, "text_preview": "\"须菩提，若有善男子、善女人，以恒河沙等身命布施；若复有人，于此经中乃至受持四句偈等，为他人说，其福甚多。\"", "char_count": 54, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00053", "chapter_id": "c013", "para_no": 1, "text_preview": "尔时，须菩提闻说是经，深解义趣，涕泪悲泣而白佛言：\"希有，世尊！佛说如是甚深经典，我从昔来所得慧眼，未曾得闻如是之经。", "char_count": 59, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00054", "chapter_id": "c013", "para_no": 2, "text_preview": "世尊，若复有人得闻是经，信心清净，则生实相，当知是人成就第一希有功德。世尊，是实相者，即是非相，是故如来说名实相。", "char_count": 57, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": ["c009"]}, {"id": "p00055", "chapter_id": "c013", "para_no": 3, "text_preview": "世尊，我今得闻如是经典，信解受持，不足为难。若当来世后五百岁，其有众生得闻是经，信解受持，是人则为第一希有。何以故？此人无我相、无人相、无众生相、无寿者相。所以", "char_count": 121, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": ["c005"]}, {"id": "p00056", "chapter_id": "c013", "para_no": 4, "text_preview": "佛告须菩提：\"如是，如是。若复有人得闻是经，不惊、不怖、不畏，当知是人甚为希有。何以故？须菩提，如来说第一波罗蜜，即非第一波罗蜜，是名第一波罗蜜。", "char_count": 73, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00057", "chapter_id": "c013", "para_no": 5, "text_preview": "须菩提，忍辱波罗蜜，如来说非忍辱波罗蜜，是名忍辱波罗蜜。何以故？须菩提，如我昔为歌利王割截身体，我于尔时无我相、无人相、无众生相、无寿者相。何以故？我于往昔节节", "char_count": 105, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": ["c005"]}, {"id": "p00058", "chapter_id": "c013", "para_no": 6, "text_preview": "须菩提，又念过去于五百世作忍辱仙人，于尔所世无我相、无人相、无众生相、无寿者相。是故，须菩提，菩萨应离一切相，发阿耨多罗三藐三菩提心，不应住色生心，不应住声、香", "char_count": 165, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": ["c005"]}, {"id": "p00059", "chapter_id": "c013", "para_no": 7, "text_preview": "须菩提，如来是真语者、实语者、如语者、不诳语者、不异语者。须菩提，如来所得法，此法无实无虚。", "char_count": 46, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00060", "chapter_id": "c013", "para_no": 8, "text_preview": "须菩提，若菩萨心住于法而行布施，如人入暗，则无所见。若菩萨心不住法而行布施，如人有目，日光明照，见种种色。", "char_count": 53, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00061", "chapter_id": "c013", "para_no": 9, "text_preview": "须菩提，当来之世，若有善男子、善女人，能于此经受持读诵，则为如来以佛智慧悉知是人，悉见是人，皆得成就无量无边功德。\"", "char_count": 58, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00062", "chapter_id": "c014", "para_no": 1, "text_preview": "\"须菩提，若有善男子、善女人，初日分以恒河沙等身布施，中日分复以恒河沙等身布施，后日分亦以恒河沙等身布施，如是无量百千万亿劫以身布施。若复有人闻此经典，信心不逆", "char_count": 102, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00063", "chapter_id": "c014", "para_no": 2, "text_preview": "须菩提，以要言之，是经有不可思议、不可称量、无边功德。如来为发大乘者说，为发最上乘者说。若有人能受持读诵，广为人说，如来悉知是人，悉见是人，皆得成就不可量、不可", "char_count": 159, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00064", "chapter_id": "c014", "para_no": 3, "text_preview": "须菩提，在在处处若有此经，一切世间天、人、阿修罗所应供养。当知此处则为是塔，皆应恭敬作礼围绕，以诸华香而散其处。\"", "char_count": 57, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00065", "chapter_id": "c015", "para_no": 1, "text_preview": "\"复次，须菩提，善男子、善女人受持读诵此经，若为人轻贱，是人先世罪业应堕恶道，以今世人轻贱故，先世罪业则为消灭，当得阿耨多罗三藐三菩提。", "char_count": 68, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00066", "chapter_id": "c015", "para_no": 2, "text_preview": "须菩提，我念过去无量阿僧祇劫，于然灯佛前，得值八百四千万亿那由他诸佛，悉皆供养承事，无空过者。若复有人于后末世，能受持读诵此经所得功德，于我所供养诸佛功德，百分", "char_count": 99, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00067", "chapter_id": "c015", "para_no": 3, "text_preview": "须菩提，若善男子、善女人于后末世，有受持读诵此经，所得功德我若具说者，或有人闻，心则狂乱，狐疑不信。须菩提，当知是经义不可思议，果报亦不可思议。\"", "char_count": 73, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00068", "chapter_id": "c016", "para_no": 1, "text_preview": "尔时，须菩提白佛言：\"世尊，善男子、善女人发阿耨多罗三藐三菩提心，云何应住？云何降伏其心？\"", "char_count": 46, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00069", "chapter_id": "c016", "para_no": 2, "text_preview": "佛告须菩提：\"善男子、善女人发阿耨多罗三藐三菩提心者，当生如是心：我应灭度一切众生，灭度一切众生已，而无有一众生实灭度者。何以故？须菩提，若菩萨有我相、人相、众", "char_count": 118, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": ["c008"]}, {"id": "p00070", "chapter_id": "c016", "para_no": 3, "text_preview": "须菩提，于意云何？如来于然灯佛所，有法得阿耨多罗三藐三菩提不？\"", "char_count": 32, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00071", "chapter_id": "c016", "para_no": 4, "text_preview": "\"不也，世尊。如我解佛所说义，佛于然灯佛所，无有法得阿耨多罗三藐三菩提。\"", "char_count": 37, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00072", "chapter_id": "c016", "para_no": 5, "text_preview": "佛言：\"如是，如是。须菩提，实无有法如来得阿耨多罗三藐三菩提。须菩提，若有法如来得阿耨多罗三藐三菩提，然灯佛则不与我授记：'汝于来世当得作佛，号释迦牟尼。'以实", "char_count": 139, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00073", "chapter_id": "c016", "para_no": 6, "text_preview": "若有人言'如来得阿耨多罗三藐三菩提'，须菩提，实无有法佛得阿耨多罗三藐三菩提。须菩提，如来所得阿耨多罗三藐三菩提，于是中无实无虚，是故如来说一切法皆是佛法。须菩", "char_count": 102, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00074", "chapter_id": "c016", "para_no": 7, "text_preview": "须菩提，譬如人身长大。\"", "char_count": 12, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00075", "chapter_id": "c016", "para_no": 8, "text_preview": "须菩提言：\"世尊，如来说人身长大，即为非大身，是名大身。\"", "char_count": 29, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00076", "chapter_id": "c016", "para_no": 9, "text_preview": "\"须菩提，菩萨亦如是，若作是言'我当灭度无量众生'，则不名菩萨。何以故？须菩提，实无有法名为菩萨。是故佛说一切法无我、无人、无众生、无寿者。", "char_count": 70, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": ["c005", "c008"]}, {"id": "p00077", "chapter_id": "c016", "para_no": 10, "text_preview": "须菩提，若菩萨作是言'我当庄严佛土'，是不名菩萨。何以故？如来说庄严佛土者，即非庄严，是名庄严。", "char_count": 48, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00078", "chapter_id": "c016", "para_no": 11, "text_preview": "须菩提，若菩萨通达无我法者，如来说名真是菩萨。\"", "char_count": 24, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": ["c005"]}, {"id": "p00079", "chapter_id": "c017", "para_no": 1, "text_preview": "\"须菩提，于意云何？如来有肉眼不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00080", "chapter_id": "c017", "para_no": 2, "text_preview": "\"如是，世尊，如来有肉眼。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00081", "chapter_id": "c017", "para_no": 3, "text_preview": "\"须菩提，于意云何？如来有天眼不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00082", "chapter_id": "c017", "para_no": 4, "text_preview": "\"如是，世尊，如来有天眼。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00083", "chapter_id": "c017", "para_no": 5, "text_preview": "\"须菩提，于意云何？如来有慧眼不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00084", "chapter_id": "c017", "para_no": 6, "text_preview": "\"如是，世尊，如来有慧眼。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00085", "chapter_id": "c017", "para_no": 7, "text_preview": "\"须菩提，于意云何？如来有法眼不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00086", "chapter_id": "c017", "para_no": 8, "text_preview": "\"如是，世尊，如来有法眼。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00087", "chapter_id": "c017", "para_no": 9, "text_preview": "\"须菩提，于意云何？如来有佛眼不？\"", "char_count": 18, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00088", "chapter_id": "c017", "para_no": 10, "text_preview": "\"如是，世尊，如来有佛眼。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00089", "chapter_id": "c017", "para_no": 11, "text_preview": "\"须菩提，于意云何？如恒河中所有沙，佛说是沙不？\"", "char_count": 25, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00090", "chapter_id": "c017", "para_no": 12, "text_preview": "\"如是，世尊，如来说是沙。\"", "char_count": 14, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00091", "chapter_id": "c017", "para_no": 13, "text_preview": "\"须菩提，于意云何？如一恒河中所有沙，有如是等恒河，是诸恒河所有沙数佛世界，如是宁为多不？\"", "char_count": 46, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00092", "chapter_id": "c017", "para_no": 14, "text_preview": "\"甚多，世尊。\"", "char_count": 8, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00093", "chapter_id": "c017", "para_no": 15, "text_preview": "佛告须菩提：\"尔所国土中所有众生若干种心，如来悉知。何以故？如来说诸心，皆为非心，是名为心。所以者何？须菩提，过去心不可得，现在心不可得，未来心不可得。\"", "char_count": 77, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00094", "chapter_id": "c018", "para_no": 1, "text_preview": "\"须菩提，于意云何？若有人满三千大千世界七宝以用布施，是人以是因缘得福多不？\"", "char_count": 39, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00095", "chapter_id": "c018", "para_no": 2, "text_preview": "\"如是，世尊，此人以是因缘得福甚多。\"", "char_count": 19, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00096", "chapter_id": "c018", "para_no": 3, "text_preview": "\"须菩提，若福德有实，如来不说得福德多；以福德无故，如来说得福德多。\"", "char_count": 35, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00097", "chapter_id": "c019", "para_no": 1, "text_preview": "\"须菩提，于意云何？佛可以具足色身见不？\"", "char_count": 21, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00098", "chapter_id": "c019", "para_no": 2, "text_preview": "\"不也，世尊。如来不应以具足色身见。何以故？如来说具足色身，即非具足色身，是名具足色身。\"", "char_count": 45, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00099", "chapter_id": "c019", "para_no": 3, "text_preview": "\"须菩提，于意云何？如来可以具足诸相见不？\"", "char_count": 22, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00100", "chapter_id": "c019", "para_no": 4, "text_preview": "\"不也，世尊。如来不应以具足诸相见。何以故？如来说诸相具足，即非具足，是名诸相具足。\"", "char_count": 43, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00101", "chapter_id": "c020", "para_no": 1, "text_preview": "\"须菩提，汝勿谓如来作是念'我当有所说法'，莫作是念。何以故？若人言如来有所说法，即为谤佛，不能解我所说故。须菩提，说法者，无法可说，是名说法。\"", "char_count": 73, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00102", "chapter_id": "c020", "para_no": 2, "text_preview": "尔时，慧命须菩提白佛言：\"世尊，颇有众生于未来世闻说是法，生信心不？\"", "char_count": 35, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00103", "chapter_id": "c020", "para_no": 3, "text_preview": "佛言：\"须菩提，彼非众生，非不众生。何以故？须菩提，众生众生者，如来说非众生，是名众生。\"", "char_count": 45, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00104", "chapter_id": "c021", "para_no": 1, "text_preview": "须菩提白佛言：\"世尊，佛得阿耨多罗三藐三菩提，为无所得耶？\"", "char_count": 30, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00105", "chapter_id": "c021", "para_no": 2, "text_preview": "佛言：\"如是，如是。须菩提，我于阿耨多罗三藐三菩提，乃至无有少法可得，是名阿耨多罗三藐三菩提。\"", "char_count": 48, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00106", "chapter_id": "c022", "para_no": 1, "text_preview": "复次，须菩提，是法平等，无有高下，是名阿耨多罗三藐三菩提。以无我、无人、无众生、无寿者，修一切善法，即得阿耨多罗三藐三菩提。须菩提，所言善法者，如来说即非善法，", "char_count": 85, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": ["c005"]}, {"id": "p00107", "chapter_id": "c023", "para_no": 1, "text_preview": "\"须菩提，若三千大千世界中所有诸须弥山王，如是等七宝聚，有人持用布施；若人以此般若波罗蜜经乃至四句偈等，受持读诵、为他人说，于前福德百分不及一，百千万亿分乃至算", "char_count": 89, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00108", "chapter_id": "c024", "para_no": 1, "text_preview": "\"须菩提，于意云何？汝等勿谓如来作是念'我当度众生'。须菩提，莫作是念。何以故？实无有众生如来度者。若有众生如来度者，如来则有我、人、众生、寿者。", "char_count": 73, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00109", "chapter_id": "c024", "para_no": 2, "text_preview": "须菩提，如来说有我者，即非有我，而凡夫之人以为有我。须菩提，凡夫者，如来说即非凡夫，是名凡夫。\"", "char_count": 48, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00110", "chapter_id": "c025", "para_no": 1, "text_preview": "\"须菩提，于意云何？可以三十二相观如来不？\"", "char_count": 22, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00111", "chapter_id": "c025", "para_no": 2, "text_preview": "须菩提言：\"如是，如是，以三十二相观如来。\"", "char_count": 22, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00112", "chapter_id": "c025", "para_no": 3, "text_preview": "佛言：\"须菩提，若以三十二相观如来者，转轮圣王即是如来。\"", "char_count": 29, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00113", "chapter_id": "c025", "para_no": 4, "text_preview": "须菩提白佛言：\"世尊，如我解佛所说义，不应以三十二相观如来。\"", "char_count": 31, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00114", "chapter_id": "c025", "para_no": 5, "text_preview": "尔时，世尊而说偈言：", "char_count": 10, "section_type": "偈颂引导", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00115", "chapter_id": "c025", "para_no": 6, "text_preview": "若以色见我，以音声求我，", "char_count": 12, "section_type": "偈颂", "gatha_id": "g000", "mantra_id": null, "figures": [], "doctrines": []}, {"id": "p00116", "chapter_id": "c025", "para_no": 7, "text_preview": "是人行邪道，不能见如来。", "char_count": 12, "section_type": "偈颂", "gatha_id": "g000", "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00117", "chapter_id": "c026", "para_no": 1, "text_preview": "\"须菩提，汝若作是念'如来不以具足相故得阿耨多罗三藐三菩提'。须菩提，莫作是念'如来不以具足相故得阿耨多罗三藐三菩提'。", "char_count": 60, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00118", "chapter_id": "c026", "para_no": 2, "text_preview": "须菩提，汝若作是念'发阿耨多罗三藐三菩提心者，说诸法断灭'，莫作是念。何以故？发阿耨多罗三藐三菩提心者，于法不说断灭相。\"", "char_count": 61, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00119", "chapter_id": "c027", "para_no": 1, "text_preview": "\"须菩提，若菩萨以满恒河沙等世界七宝持用布施；若复有人知一切法无我，得成于忍，此菩萨胜前菩萨所得功德。何以故？须菩提，以诸菩萨不受福德故。\"", "char_count": 70, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": ["c005"]}, {"id": "p00120", "chapter_id": "c027", "para_no": 2, "text_preview": "须菩提白佛言：\"世尊，云何菩萨不受福德？\"", "char_count": 21, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00121", "chapter_id": "c027", "para_no": 3, "text_preview": "\"须菩提，菩萨所作福德，不应贪著，是故说不受福德。\"", "char_count": 26, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00122", "chapter_id": "c028", "para_no": 1, "text_preview": "\"须菩提，若有人言'如来若来若去，若坐若卧'，是人不解我所说义。何以故？如来者，无所从来，亦无所去，故名如来。\"", "char_count": 56, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00123", "chapter_id": "c029", "para_no": 1, "text_preview": "\"须菩提，若善男子、善女人，以三千大千世界碎为微尘，于意云何？是微尘众宁为多不？\"", "char_count": 41, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00124", "chapter_id": "c029", "para_no": 2, "text_preview": "须菩提言：\"甚多，世尊。何以故？若是微尘众实有者，佛则不说是微尘众。所以者何？佛说微尘众，即非微尘众，是名微尘众。", "char_count": 57, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00125", "chapter_id": "c029", "para_no": 3, "text_preview": "世尊，如来所说三千大千世界，即非世界，是名世界。何以故？若世界实有者，即是一合相。如来说一合相，即非一合相，是名一合相。\"", "char_count": 61, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00126", "chapter_id": "c029", "para_no": 4, "text_preview": "\"须菩提，一合相者，即是不可说，但凡夫之人贪著其事。\"", "char_count": 27, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00127", "chapter_id": "c030", "para_no": 1, "text_preview": "\"须菩提，若人言'佛说我见、人见、众生见、寿者见'，须菩提，于意云何？是人解我所说义不？\"", "char_count": 45, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}, {"id": "p00128", "chapter_id": "c030", "para_no": 2, "text_preview": "\"不也，世尊。是人不解如来所说义。何以故？世尊说我见、人见、众生见、寿者见，即非我见、人见、众生见、寿者见，是名我见、人见、众生见、寿者见。\"", "char_count": 71, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001"], "doctrines": []}, {"id": "p00129", "chapter_id": "c030", "para_no": 3, "text_preview": "\"须菩提，发阿耨多罗三藐三菩提心者，于一切法应如是知、如是见、如是信解，不生法相。须菩提，所言法相者，如来说即非法相，是名法相。\"", "char_count": 65, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p001", "p205"], "doctrines": []}, {"id": "p00130", "chapter_id": "c031", "para_no": 1, "text_preview": "\"须菩提，若有人以满无量阿僧祇世界七宝持用布施；若有善男子、善女人发菩提心者，持于此经乃至四句偈等，受持读诵、为人演说，其福胜彼。云何为人演说？不取于相，如如不", "char_count": 86, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": ["c002"]}, {"id": "p00131", "chapter_id": "c031", "para_no": 2, "text_preview": "一切有为法，如梦幻泡影，", "char_count": 12, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": [], "doctrines": []}, {"id": "p00132", "chapter_id": "c031", "para_no": 3, "text_preview": "如露亦如电，应作如是观。\"", "char_count": 13, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": [], "doctrines": []}, {"id": "p00133", "chapter_id": "c031", "para_no": 4, "text_preview": "佛说是经已，长老须菩提及诸比丘、比丘尼、优婆塞、优婆夷，一切世间天、人、阿修罗，闻佛所说，皆大欢喜，信受奉行。", "char_count": 55, "section_type": "长行", "gatha_id": null, "mantra_id": null, "figures": ["p205"], "doctrines": []}], "gathas": [{"id": "g000", "chapter_id": "c025", "name": "偈颂", "meter": "五言", "text_preview": "若以色见我，以音声求我，是人行邪道，不能见如来。", "char_count": 24}], "mantras": [], "figure_mentions": [{"figure_id": "p205", "name": "须菩提", "chapters": ["c001", "c002", "c003", "c004", "c005", "c006", "c007", "c008", "c009", "c010", "c011", "c012", "c013", "c014", "c015", "c016", "c017", "c018", "c019", "c020", "c021", "c022", "c023", "c024", "c025", "c026", "c027", "c028", "c029", "c030", "c031"], "mention_count": 31}, {"figure_id": "p001", "name": "释迦牟尼佛", "chapters": ["c000", "c001", "c003", "c004", "c005", "c006", "c007", "c008", "c009", "c010", "c011", "c012", "c013", "c014", "c016", "c017", "c018", "c019", "c020", "c021", "c022", "c024", "c025", "c026", "c027", "c028", "c029", "c030"], "mention_count": 28}], "doctrine_mentions": [{"concept_id": "c005", "name": "空性", "chapters": ["c013", "c016", "c022", "c027"], "mention_count": 4}, {"concept_id": "c008", "name": "涅槃", "chapters": ["c002", "c006", "c016"], "mention_count": 3}, {"concept_id": "c009", "name": "实相", "chapters": ["c013"], "mention_count": 1}, {"concept_id": "c002", "name": "真如", "chapters": ["c031"], "mention_count": 1}], "translator_note": "译事未入大事年表", "transmission_events": ["event:translation:鳩摩羅什"]}