{"id": "jingang_jiumo", "type": "Text", "title": "金刚般若波罗蜜经", "title_zh": "金刚般若波罗蜜经", "translator": "鸠摩罗什", "category": "般若部类", "volume": "", "juan_count": 1, "actual_char_count": 6625, "canon_ref": "T.220", "taisho": "T0220", "vehicle": "大乘", "mode": "显教", "translation_place": "草堂寺", "time_from": 402, "belongs_to_school": ["般若", "中观宗", "三论宗"], "parallel_translations": [], "kepan": {"序分": [], "正宗分": ["c000", "c001", "c002", "c003", "c004", "c005", "c006", "c007", "c008", "c009", "c010", "c011", "c012", "c013", "c014", "c015", "c016", "c017", "c018", "c019", "c020", "c021", "c022", "c023", "c024", "c025", "c026", "c027", "c028", "c029", "c030", "c031"], "流通分": []}, "chapters": [{"id": "c000", "chapter_no": 1, "chapter_title": "法会因由分第一", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00000"], "gathas": [], "mantras": [], "figures": ["p001"], "doctrines": [], "char_count": 85}, {"id": "c001", "chapter_no": 2, "chapter_title": "善现启请分第二", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00001", "p00002", "p00003"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 184}, {"id": "c002", "chapter_no": 3, "chapter_title": "大乘正宗分第三", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00004"], "gathas": [], "mantras": [], "figures": ["p205"], "doctrines": ["c008"], "char_count": 137}, {"id": "c003", "chapter_no": 4, "chapter_title": "妙行无住分第四", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00005", "p00006", "p00007", "p00008", "p00009", "p00010"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 180}, {"id": "c004", "chapter_no": 5, "chapter_title": "如理实见分第五", "section_type": "章节", "part_of_kepan": "正宗分", "paragraphs": ["p00011", "p00012", "p00013"], "gathas": [], "mantras": [], "figures": ["p001", "p205"], "doctrines": [], "char_count": 84}, {"id": "c005", "chapter_no": 6, "chapter_title": "正信稀有分第六", "section_type": "章节", "part_of_kepan": "正宗